
# Application
APP_NAME=Robotics Fleet Manager
APP_ENV=development
LOG_LEVEL=INFO

# Backend
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# PostgreSQL
POSTGRES_DB=robotics_fleet
POSTGRES_USER=fleet_user
POSTGRES_PASSWORD=change_me_for_local_development

DATABASE_URL=postgresql+asyncpg://fleet_user:change_me_for_local_development@localhost:5432/robotics_fleet

# Redis
REDIS_URL=redis://localhost:6379/0

# Simulator
SIMULATION_ENABLED=true
SIMULATION_ROBOT_COUNT=5
SIMULATION_TICK_SECONDS=1

# Authentication (configure before enabling protected APIs)
JWT_SECRET=replace_with_a_secure_random_secret
JWT_ALGORITHM=HS256
